POSTGRES_USER=agronexus
POSTGRES_PASSWORD=change-me
POSTGRES_DB=agronexus

DATABASE_URL=postgresql+psycopg2://agronexus:change-me@db:5432/agronexus

# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=generate-a-long-random-string-of-at-least-32-characters
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# development or production (production refuses a weak SECRET_KEY)
ENVIRONMENT=development

# comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:4200

# https://openweathermap.org/api (free plan)
OPENWEATHER_API_KEY=

# optional: https://data.gov.in (only needed for a live price sync, which is not built yet)
DATAGOV_API_KEY=